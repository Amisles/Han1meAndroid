    <!-- About (extra) -->
    <string name="about_logo">應用程式圖示</string>
    <string name="about_app_name">Hanime Android</string>
    <string name="about_intro_body">Hanime Android 是一款開源的第三方 Hanime 客戶端，提供流暢的影片瀏覽、搜尋、線上播放與離線下載功能。本專案基於 AGP 9.2.1 + Kotlin 2.4.10 + Jetpack Compose BOM 2026.06 建構，採用 MVVM + Repository 架構，UI 層、解析層、網路層清晰解耦。網路層使用 OkHttp 5.4.0，圖片載入使用 Coil 3.5.0，資料持久化使用 Room 2.8.4，影片播放基於 Media3 1.10.1。專案以 GPLv3.0 協議完全開源，歡迎社群自由學習與二次開發。</string>
    <string name="about_license_body">本專案採用 GPLv3.0 協議開源。您可以自由地使用、研究、修改和分發本軟體，但分發本軟體或其衍生作品時，必須同樣以 GPLv3.0 協議開源完整原始碼，並保留原始版權聲明與協議文字。任何再分發不得施加超出 GPLv3.0 的額外限制。</string>
    <string name="about_made_with">由開源社群用 ♥ 製作</string>
    <string name="about_oss_agp_desc">Android 官方建構工具鏈，9.x 內建 Kotlin 編譯支援</string>
    <string name="about_oss_kotlin_desc">JetBrains 現代 JVM/Android 靜態型別程式語言</string>
    <string name="about_oss_compose_desc">Google 官方現代 Android UI 工具包，宣告式建構原生介面</string>
    <string name="about_oss_exoplayer_desc">Android 官方媒體播放器，支援 HLS 高清串流播放</string>
    <string name="about_oss_okhttp_desc">Square 出品的高效能 HTTP 客戶端，支援 HTTP/2 與連線池</string>
    <string name="about_oss_jsoup_desc">HTML DOM 解析與 CSS 選擇器庫</string>
    <string name="about_oss_coil_desc">Kotlin 協程驅動的 Android 圖片載入庫（io.coil-kt.coil3）</string>
