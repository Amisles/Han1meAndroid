# Gradle 构建产物
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# 输出文件
*.apk
*.aab
*.dex
*.class

# 抓包/调试临时文件
*.har
cookies.txt
jar.txt
评论.txt

# Android Studio 配置
.idea/
!app/.idea/.gitignore
captures/
.externalNativeBuild/
.cxx/
local.properties

# Gradle 缓存
.gradle/

# IDE 缓存
*.iml
.kotlin/

# HTML 样本文件（调试用）
*.html
!src/test/resources/**/*.html
!**/src/test/resources/**/*.html

# 日志文件
*.log

# 临时文件
*.download
*.tmp

# 签名文件（含私钥，不得提交）
*.jks
*.keystore
keystore.properties

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
